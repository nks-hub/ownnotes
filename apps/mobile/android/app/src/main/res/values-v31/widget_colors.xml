<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+, light: roles from the wallpaper's tonal palettes, mapped as in
     Material 3 (surface with on-surface, accent with on-accent, container with
     on-container). -->
<resources>
    <color name="widget_surface">@android:color/system_neutral1_10</color>
    <color name="widget_raised">@android:color/system_neutral1_50</color>
    <color name="widget_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_secondary">@android:color/system_neutral2_700</color>
    <color name="widget_accent">@android:color/system_accent1_600</color>
    <color name="widget_on_accent">@android:color/system_accent1_0</color>
    <color name="widget_container">@android:color/system_accent1_100</color>
    <color name="widget_on_container">@android:color/system_accent1_900</color>
    <color name="widget_outline">@android:color/system_neutral2_500</color>
</resources>
